# 1. Берем официальный образ Python (базовую ОС с питоном)
FROM python:3.12-slim

# 2. Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем файл с зависимостями
COPY requirements.txt .

# 4. Устанавливаем библиотеки (без кэша, чтобы образ был меньше)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем весь остальной код в контейнер
COPY . .

# 6. Открываем порт 8000 (чтобы к нему можно было подключиться)
EXPOSE 8000

# 7. Команда, которая запустится при старте контейнера
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]